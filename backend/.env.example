FLASK_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/course_advisor
SECRET_KEY=your-secret-key-change-in-production
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini

# Password reset (optional). If MAIL_SERVER is unset, reset emails are not sent unless Flask debug is on
# (then the API returns devResetLink in the JSON response).
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_HOURS=1
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
